# Azure Llama / LLM Deployment Configuration
AZURE_DEPLOYMENT=""
AZURE_ENDPOINT=""
AZURE_LLAMAKEY=
AZURE_DEPLOYMENT_NAME=

# Optional LLM Tuning Settings
AWA_LLM_TEMPERATURE=0.0
AWA_LLM_TIMEOUT=30.0
AWA_LLM_BUSINESS_REPORT_TIMEOUT_SECONDS=60.0
AWA_LLM_RETRY_ATTEMPTS=2
AWA_LLM_MAX_TOKENS=500
AWA_LLM_ENABLED=true

# AWA Backend Server Settings
AWA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AWA_MAX_UPLOAD_BYTES=52428800
AWA_STORAGE_TTL_SECONDS=3600
AWA_LOG_LEVEL=INFO

# Code-Based Workflows (Python) External Application URL
CODE_BASED_WORKFLOWS_URL=https://google.com

# KPI Ontology Bank External Application URL
KPI_ONTOLOGY_BANK_URL=https://google.com

# Email & SMTP Configuration for Rationalisation Recommendations (Optional)
EMAIL_FROM_ADDRESS=etlagent@exlservice.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# License Enforcement Configuration (Databricks Secret Scope)
# Licensing is permanently enforced in production and cannot be disabled by environment variables.
# The Ed25519 public key is embedded at build time and cannot be overridden by the client.
# Validates signed license artifact stored in Databricks Secret Scope backed by Azure Key Vault.
# NOTE: Production identity (license_id, product, environment) and secret scope/key are
# immutable constants in the production build and cannot be overridden by client environment variables.
# The entries below document the active production configuration bindings:
ALTERYX_LICENSE_SECRET_SCOPE=alteryx-licenseArtifacts
ALTERYX_LICENSE_SECRET_NAME=alteryx-license
ALTERYX_LICENSE_ID=CLIENT-ALTERYX-001
ALTERYX_LICENSE_PRODUCT=alteryx-etl
ALTERYX_LICENSE_ENVIRONMENT=production
