# Azure Key Vault Configuration
# Production authentication uses App Service System-Assigned Managed Identity.
# For local development, DefaultAzureCredential uses the developer's Azure CLI login.
AZURE_KEY_VAULT_URL=
AZURE_LICENSE_PRIVATE_KEY_SECRET_NAME=alteryx-license-private-key

# Default Environment-Backed License Record (for standalone operation / testing)
ALTERYX_LICENSE_ID=
ALTERYX_LICENSE_PRODUCT=alteryx-etl
ALTERYX_LICENSE_ENVIRONMENT=production
ALTERYX_LICENSE_STATUS=active
ALTERYX_LICENSE_EXPIRY=
ALTERYX_LICENSE_LEASE_SECONDS=86400

# JSON formatted feature flags
ALTERYX_LICENSE_FEATURES={"workflow_analysis":true,"portfolio_rationalisation":true,"python_translation":true,"export_reports":true}

# API-level access authentication secret (Bearer token)
ALTERYX_LICENSE_API_CLIENT_SECRET=
